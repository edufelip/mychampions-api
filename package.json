{
  "name": "mychampions-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:web-e2e": "bun scripts/web-e2e-server.ts",
    "start": "bun src/index.ts",
    "build": "bun run typecheck",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src tests drizzle.config.ts",
    "test": "bun test",
    "test:unit": "bun test tests",
    "test:integration": "bun test tests",
    "test:contract": "bun test tests/stack-contract.test.ts tests/vm-deployment-contract.test.ts",
    "evidence:revenuecat-live": "bash infra/scripts/verify-revenuecat-live-evidence.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/bearer": "~1.4.0",
    "@elysiajs/cors": "~1.4.0",
    "@elysiajs/jwt": "~1.4.0",
    "@google-cloud/storage": "^7.21.0",
    "@sinclair/typebox": "~0.34.41",
    "drizzle-orm": "~0.45.0",
    "elysia": "~1.4.0",
    "jose": "~6.1.3",
    "postgres": "~3.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "drizzle-kit": "~0.31.8",
    "eslint": "^10.8.1",
    "typescript": "^5.9.2"
  }
}
