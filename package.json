    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/bearer": "~1.4.0",
    "@elysiajs/cors": "~1.4.0",
    "@elysiajs/jwt": "~1.4.0",
    "@google-cloud/storage": "^7.21.0",
    "@sinclair/typebox": "~0.34.41",
    "drizzle-orm": "~0.45.0",
    "elysia": "~1.4.0",
    "jose": "~6.1.3",
    "postgres": "~3.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "~0.31.8",
    "typescript": "^5.9.2"
  }
}
