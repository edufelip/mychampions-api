{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mychampions.test/testing/api-process-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "ownerTokenHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pid": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2147483647
    },
    "started": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "attempt": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,48}$"
    },
    "origin": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "ownerTokenHash",
    "pid",
    "started",
    "script",
    "attempt",
    "origin"
  ]
}
